# Lux3D Global API key — https://lux3d.aholo.ai  (Global and China keys are NOT interchangeable)
# Used ONLY by scripts/lux3d/* at build time. Never imported by src/.
LUX3D_API_KEY=

# Lux3D Global host + prefix (do not point this at the China host with a Global key)
LUX3D_BASE_URL=https://api.aholo.ai/global

# LLM provider for challenge generation (server-side only)
ANTHROPIC_API_KEY=
