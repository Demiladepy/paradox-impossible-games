{
  "name": "paradox",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "PARADOX: THE IMPOSSIBLE GAMES - an AI-generated 3D survival game",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "gen:asset": "node --env-file=.env --import tsx scripts/lux3d/generate.ts",
    "gen:character": "node --env-file=.env --import tsx scripts/lux3d/character.ts",
    "inspect:asset": "node --import tsx scripts/lux3d/inspect.ts",
    "relabel:clips": "node --import tsx scripts/lux3d/relabel.ts"
  },
  "dependencies": {
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "@react-three/rapier": "2.2.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.187.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.12.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "@vitejs/plugin-react": "6.3.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
