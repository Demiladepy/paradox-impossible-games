{
  "name": "paradox",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "PARADOX: THE IMPOSSIBLE GAMES - an AI-generated 3D survival game",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "gen:asset": "node --env-file=.env --import tsx scripts/lux3d/generate.ts",
    "gen:character": "node --env-file=.env --import tsx scripts/lux3d/character.ts",
    "inspect:asset": "node --import tsx scripts/lux3d/inspect.ts",
    "relabel:clips": "node --import tsx scripts/lux3d/relabel.ts",
    "optimize:asset": "node --import tsx scripts/lux3d/optimize.ts",
    "analyze:arena": "node --import tsx scripts/analyze-arena.ts",
    "probe:fallbacks": "node --import tsx scripts/probe-fallbacks.ts",
    "probe:control": "node --import tsx scripts/probe-control.ts",
    "budget": "node --import tsx scripts/budget.ts",
    "probe:demo": "node --import tsx scripts/probe-demonstration.ts",
    "report": "node --import tsx scripts/build-report.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@dimforge/rapier3d-compat": "^0.21.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "@react-three/postprocessing": "^3.2.2",
    "postprocessing": "^6.39.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.187.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@types/node": "^22.12.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "@vitejs/plugin-react": "6.3.0",
    "sharp": "^0.35.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
